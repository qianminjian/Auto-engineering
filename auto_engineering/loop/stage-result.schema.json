{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-engineering.dev/schemas/stage-result.schema.json",
  "$comment": "stage-result contract schema v1.1 — Host-to-core Protocol Envelope SSOT.",
  "title": "Stage Result Envelope",
  "type": "object",
  "required": [
    "schema_version", "message_type", "message_id", "thread_id", "tick",
    "stage", "causation_id", "correlation_id", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "message_type": {"const": "result"},
    "message_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "tick": {"type": "integer", "minimum": 0},
    "stage": {
      "type": "string",
      "enum": [
        "gap_scan", "gap_review", "research", "architect", "developer",
        "critic", "component_verifier", "plate_deep_audit",
        "system_verifier", "system_deep_audit", "project_setup", "session_claimed"
      ]
    },
    "causation_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "extensions": {"type": "object"},
    "plan": {"type": "string"},
    "batch_plan": {"type": "array"},
    "plan_patch": {
      "type": "object",
      "required": ["add_batches"],
      "properties": {
        "base_revision": {"type": "integer", "minimum": 0},
        "add_batches": {"type": "array", "minItems": 1},
        "obligation_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_ref"],
            "properties": {
              "source_ref": {"type": "string", "minLength": 1},
              "add_implementation_targets": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "add_verification_targets": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "add_contract_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        },
        "reopen_completed": {"const": false}
      },
      "additionalProperties": false
    },
    "source_revision": {"type": "integer", "minimum": 1},
    "classifications": {"type": "array", "items": {"type": "object"}},
    "new_batch_plan": {"type": "array"},
    "file_list": {"type": "array"},
    "contracts": {"type": "object"},
    "obligations": {"type": "array"},
    "decision_impacts": {"type": "array", "items": {"type": "object"}},
    "design_change_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source", "source_ref", "requested_authority",
          "change_summary", "affected_design_refs"
        ],
        "properties": {
          "source": {"enum": ["research", "agent_assumption"]},
          "source_ref": {"type": "string", "minLength": 1},
          "requested_authority": {"const": "binding"},
          "change_summary": {"type": "string", "minLength": 1},
          "affected_design_refs": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "batch_id": {"type": ["string", "null"]},
    "files_changed": {"type": "array"},
    "commit_hash": {"type": "string"},
    "test_results": {"type": "object"},
    "verdict": {"type": "string"},
    "findings": {"type": ["array", "string"]},
    "critic_feedback": {"type": "string"},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "assessment": {"type": "string"},
    "assurance_bundle": {
      "type": "object",
      "required": ["component_verification", "system_audit"],
      "properties": {
        "component_verification": {
          "type": "object",
          "required": ["component", "coverage_map", "missing_count", "diverged_count", "recheck_log"],
          "properties": {
            "component": {"type": "string", "minLength": 1},
            "coverage_map": {"type": "array"},
            "missing_count": {"type": "integer", "minimum": 0},
            "diverged_count": {"type": "integer", "minimum": 0},
            "recheck_log": {"type": "array"}
          },
          "additionalProperties": false
        },
        "system_audit": {
          "type": "object",
          "required": ["dimensions", "findings", "p0_count", "p1_count", "p2_count", "total_audited_files", "design_docs_stale", "design_doc_suggestions", "missing_count", "diverged_count"],
          "properties": {
            "dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "findings": {"type": "array"},
            "p0_count": {"type": "integer", "minimum": 0},
            "p1_count": {"type": "integer", "minimum": 0},
            "p2_count": {"type": "integer", "minimum": 0},
            "total_audited_files": {"type": "integer", "minimum": 0},
            "design_docs_stale": {"type": "boolean"},
            "design_doc_suggestions": {"type": ["array", "string"]},
            "missing_count": {"type": "integer", "minimum": 0},
            "diverged_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "component": {"type": ["string", "null"]},
    "coverage_map": {"type": "array"},
    "full_coverage_map": {"type": "array"},
    "missing_count": {"type": "integer"},
    "diverged_count": {"type": "integer"},
    "covered_count": {"type": "integer"},
    "total_design_items": {"type": "integer"},
    "plate": {"type": "string"},
    "p0_count": {"type": "integer"},
    "p1_count": {"type": "integer"},
    "p2_count": {"type": "integer"},
    "cross_component_issues": {"type": "array"},
    "total_audited_files": {"type": "integer"},
    "recheck_log": {"type": "array"},
    "gaps": {"type": "array"},
    "scanned_sections": {"type": "integer"},
    "has_blocking": {"type": "boolean"},
    "design_doc_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scan_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "design_section_ref", "verdict", "evidence"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^section:[0-9a-f]{16}$"},
          "design_section_ref": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["clear", "gap"]},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {"type": "array"},
    "decision": {"type": "object"},
    "sources": {"type": "array"},
    "source_tier": {"type": "string"},
    "confidence": {"type": "string"},
    "recommended_design": {"type": "string"},
    "search_status": {"type": "string"},
    "search_error": {"type": ["string", "null"]},
    "design_docs_stale": {"type": "boolean"},
    "design_doc_suggestions": {"type": "string"},
    "design_doc_updated": {"type": "boolean"},
    "red_evidence": {"type": "array"},
    "tasks_completed": {"type": "array"},
    "spawned": {"type": "boolean"},
    "spawn_proof_token": {"type": "string"},
    "spawn_error": {"type": "string"},
    "spawn_error_code": {"type": "string"},
    "spawn_retry_attempt": {"type": "integer", "minimum": 1},
    "worker_attestations": {
      "type": "array",
      "items": {"$ref": "#/$defs/workerAttestation"}
    },
    "gate_resolution": {"type": "object"},
    "escalate": {"type": "boolean"},
    "escalation_question": {"type": "string"},
    "escalation_options": {"type": ["array", "null"]},
    "escalation_default": {"type": ["string", "null"]},
    "claim_token": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1}
    ,"result_type": {"type": "string"}
    ,"artifacts": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "workerAttestation": {
      "type": "object",
      "required": [
        "platform", "action_message_id", "worker_id", "prompt_sha256",
        "requested_effort", "effective_effort", "isolation_evidence",
        "visible_capabilities_sha256", "actual_model", "status",
        "sandbox_guaranteed"
      ],
      "properties": {
        "platform": {"enum": ["claude-code", "codex"]},
        "action_message_id": {"type": "string", "minLength": 1},
        "worker_id": {"type": "string", "minLength": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requested_effort": {"type": "string", "minLength": 1},
        "effective_effort": {"type": "string", "minLength": 1},
        "isolation_evidence": {"type": "string", "minLength": 1},
        "visible_capabilities_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actual_model": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "sandbox_guaranteed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "spawned": {"const": false},
            "spawn_error_code": {
              "enum": [
                "HOST_ACTION_CONTEXT_TIMEOUT",
                "HOST_ACTION_CONTEXT_RESOURCE_EXHAUSTED",
                "HOST_ACTION_CONTEXT_FAILED"
              ]
            }
          },
          "required": ["spawned", "spawn_error_code"]
        }
      },
      "then": {
        "allOf": [
    {
      "if": {"properties": {"stage": {"const": "gap_scan"}}},
      "then": {
        "required": ["stage", "gaps", "section_findings"],
        "properties": {
          "gaps": {"type": "array"},
          "section_findings": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "gap_review"}}},
      "then": {
        "required": ["stage"],
        "anyOf": [{"required": ["decision"]}, {"required": ["decisions"]}]
      }
    },
    {
      "if": {"properties": {"stage": {"const": "research"}}},
      "then": {
        "required": ["stage"],
        "anyOf": [
          {"required": ["findings"]},
          {"required": ["recommended_design"]},
          {"required": ["search_status"]},
          {"required": ["search_error"]}
        ]
      }
    },
    {
      "if": {"properties": {"stage": {"const": "project_setup"}}},
      "then": {
        "required": ["stage", "result_type", "artifacts"],
        "properties": {"result_type": {"const": "project_setup_completed"}}
      }
    },
    {
      "if": {"properties": {"stage": {"const": "architect"}}},
      "then": {
        "required": ["stage"],
        "oneOf": [
          {"required": ["design_change_requests"]},
          {
            "required": ["plan", "file_list"],
            "anyOf": [
              {"required": ["batch_plan"]},
              {"required": ["plan_patch"]},
              {
                "required": ["result_type", "source_revision", "classifications", "new_batch_plan"],
                "properties": {"result_type": {"const": "plan_reconciliation"}}
              }
            ]
          }
        ]
      }
    },
    {
      "if": {"properties": {"stage": {"const": "developer"}}},
      "then": {"required": ["stage", "batch_id", "files_changed", "test_results"]}
    },
    {
      "if": {"properties": {"stage": {"const": "critic"}}},
      "then": {
        "required": ["stage", "verdict", "findings"],
        "properties": {
          "verdict": {"enum": ["APPROVE", "MAJOR"]},
          "findings": {"type": "array"}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "component_verifier"}}},
      "then": {
        "required": ["stage", "component", "coverage_map", "missing_count", "diverged_count"],
        "properties": {
          "coverage_map": {
            "items": {
              "type": "object",
              "properties": {
                "status": {"enum": ["IMPLEMENTED", "MISSING", "DIVERGED"]}
              },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "plate_deep_audit"}}},
      "then": {
        "required": ["stage", "plate", "findings", "p0_count", "p1_count", "p2_count", "cross_component_issues"],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {"enum": ["P0", "P1", "P2"]},
                "authority_class": {
                  "enum": ["binding_violation", "objective_defect", "advisory", "out_of_scope"]
                }
              },
              "required": ["severity"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "system_verifier"}}},
      "then": {
        "required": ["stage", "full_coverage_map", "total_design_items", "covered_count", "missing_count", "diverged_count"],
        "properties": {
          "full_coverage_map": {
            "items": {
              "type": "object",
              "properties": {
                "status": {"enum": ["IMPLEMENTED", "MISSING", "DIVERGED"]}
              },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "system_deep_audit"}}},
      "then": {
        "required": ["stage", "findings", "p0_count", "p1_count", "p2_count", "total_audited_files"],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"severity": {"enum": ["P0", "P1", "P2"]}},
              "required": ["severity"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "session_claimed"}}},
      "then": {"required": ["stage", "claim_token", "session_id", "host"]}
    }
        ]
      }
    }
  ],
  "additionalProperties": false
}
