{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-engineering.dev/schemas/stage-result.schema.json",
  "$comment": "stage-result contract schema v1.1 — Host-to-core Protocol Envelope SSOT.",
  "title": "Stage Result Envelope",
  "type": "object",
  "required": [
    "schema_version", "message_type", "message_id", "thread_id", "tick",
    "stage", "causation_id", "correlation_id", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "message_type": {"const": "result"},
    "message_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "tick": {"type": "integer", "minimum": 0},
    "stage": {
      "type": "string",
      "enum": [
        "gap_scan", "gap_review", "research", "architect", "developer",
        "critic", "component_verifier", "plate_deep_audit",
        "system_verifier", "system_deep_audit"
      ]
    },
    "causation_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "extensions": {"type": "object"},
    "plan": {"type": "string"},
    "batch_plan": {"type": "array"},
    "file_list": {"type": "array"},
    "contracts": {"type": "object"},
    "batch_id": {"type": ["string", "null"]},
    "files_changed": {"type": "array"},
    "commit_hash": {"type": "string"},
    "test_results": {"type": "object"},
    "verdict": {"type": "string"},
    "findings": {"type": ["array", "string"]},
    "critic_feedback": {"type": "string"},
    "component": {"type": ["string", "null"]},
    "coverage_map": {"type": "array"},
    "full_coverage_map": {"type": "array"},
    "missing_count": {"type": "integer"},
    "diverged_count": {"type": "integer"},
    "covered_count": {"type": "integer"},
    "total_design_items": {"type": "integer"},
    "plate": {"type": "string"},
    "p0_count": {"type": "integer"},
    "p1_count": {"type": "integer"},
    "p2_count": {"type": "integer"},
    "cross_component_issues": {"type": "array"},
    "total_audited_files": {"type": "integer"},
    "recheck_log": {"type": "array"},
    "gaps": {"type": "array"},
    "scanned_sections": {"type": "integer"},
    "has_blocking": {"type": "boolean"},
    "decisions": {"type": "array"},
    "sources": {"type": "array"},
    "source_tier": {"type": "string"},
    "confidence": {"type": "string"},
    "recommended_design": {"type": "string"},
    "search_status": {"type": "string"},
    "search_error": {"type": "string"},
    "design_docs_stale": {"type": "boolean"},
    "design_doc_suggestions": {"type": "string"},
    "design_doc_updated": {"type": "boolean"},
    "red_evidence": {"type": "array"},
    "tasks_completed": {"type": "array"},
    "spawned": {"type": "boolean"},
    "spawn_proof_token": {"type": "string"},
    "spawn_error": {"type": "string"},
    "gate_resolution": {"type": "object"},
    "escalate": {"type": "boolean"},
    "escalation_question": {"type": "string"},
    "escalation_options": {"type": ["array", "null"]},
    "escalation_default": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "architect"}}},
      "then": {"required": ["stage", "plan", "batch_plan", "file_list"]}
    },
    {
      "if": {"properties": {"stage": {"const": "developer"}}},
      "then": {"required": ["stage", "batch_id", "files_changed", "test_results"]}
    },
    {
      "if": {"properties": {"stage": {"const": "critic"}}},
      "then": {
        "required": ["stage", "verdict", "findings"],
        "properties": {
          "verdict": {"enum": ["APPROVE", "MAJOR"]},
          "findings": {"type": "array"}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "component_verifier"}}},
      "then": {
        "required": ["stage", "component", "coverage_map", "missing_count", "diverged_count"],
        "properties": {
          "coverage_map": {
            "items": {
              "type": "object",
              "properties": {
                "status": {"enum": ["IMPLEMENTED", "MISSING", "DIVERGED"]}
              },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "plate_deep_audit"}}},
      "then": {
        "required": ["stage", "plate", "findings", "p0_count", "p1_count", "p2_count", "cross_component_issues"],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"severity": {"enum": ["P0", "P1", "P2"]}},
              "required": ["severity"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "system_verifier"}}},
      "then": {
        "required": ["stage", "full_coverage_map", "total_design_items", "covered_count", "missing_count", "diverged_count"],
        "properties": {
          "full_coverage_map": {
            "items": {
              "type": "object",
              "properties": {
                "status": {"enum": ["IMPLEMENTED", "MISSING", "DIVERGED"]}
              },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "system_deep_audit"}}},
      "then": {
        "required": ["stage", "findings", "p0_count", "p1_count", "p2_count", "total_audited_files"],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"severity": {"enum": ["P0", "P1", "P2"]}},
              "required": ["severity"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
