{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-engineering.dev/schemas/action.schema.json",
  "$comment": "action contract schema v1.1 — Core-to-host Protocol Envelope SSOT.",
  "title": "Tick Action Envelope",
  "type": "object",
  "required": [
    "schema_version", "message_type", "message_id", "thread_id", "tick",
    "stage", "correlation_id", "extensions", "action"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "message_type": {"const": "action"},
    "message_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "tick": {"type": "integer", "minimum": 0},
    "stage": {"type": ["string", "null"]},
    "causation_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "extensions": {"type": "object"},
    "action": {
      "type": "string",
      "enum": [
        "gap_scan", "gap_review", "research", "architect", "developer",
        "critic", "component_verifier", "plate_deep_audit",
        "system_verifier", "system_deep_audit", "gate", "skip",
        "project_setup_required", "session_rollover", "done", "error"
      ]
    },
    "gate_summary": {"type": "object"},
    "feedback": {"type": ["string", "object", "null"]},
    "requirement": {"type": "string"},
    "feature_status": {"type": "object"},
    "progress_summary": {"type": ["string", "object", "null"]},
    "context": {"type": "object"},
    "expected_format": {"type": "object"},
    "gaps": {"type": "array"},
    "has_blocking": {"type": "boolean"},
    "is_rereview": {"type": "boolean"},
    "research_findings": {"type": "object"},
    "research_and_design_context": {"type": "array", "items": {"type": "object"}},
    "required_capabilities": {"type": "array"},
    "missing_capabilities": {"type": "array", "items": {"type": "string"}},
    "reason_code": {"type": "string"},
    "constraints": {"type": "object"},
    "gap": {"type": "object"},
    "knowledge_sources": {"type": "object"},
    "component": {"type": ["string", "null"]},
    "batch_id": {"type": ["string", "null"]},
    "tasks": {"type": "array"},
    "plan": {"type": "string"},
    "instruction": {"type": "string"},
    "subagent_prompt": {"type": "string"},
    "session_summary": {"type": "string"},
    "spawn": {"type": "object"},
    "spawn_proof_token": {"type": "string"},
    "recheck": {"type": "object"},
    "gate": {"type": "object"},
    "reason": {"type": ["string", "null"]},
    "next_transition": {"type": "string"},
    "error_code": {"type": "string"},
    "message": {"type": "string"},
    "suggestion": {"type": "string"},
    "current_state": {"type": "object"},
    "verdict": {"type": "string"},
    "verdict_level": {"type": ["integer", "null"]},
    "verdict_reason": {"type": ["string", "null"]},
    "rounds": {"type": "integer"},
    "checkpoint_id": {"type": "string"},
    "current_session_id": {"type": "string", "minLength": 1},
    "capsule": {
      "type": "object",
      "required": ["artifact_id", "sha256", "schema_version"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0"}
      },
      "additionalProperties": false
    },
    "claim_token": {"type": "string", "minLength": 1},
    "expires_at": {"type": ["string", "null"]}
    ,"metrics": {"type": "object"}
    ,"ratchet": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "gate"}}},
      "then": {"required": ["gate"]}
    },
    {
      "if": {"properties": {"action": {"const": "skip"}}},
      "then": {"required": ["reason", "next_transition"]}
    },
    {
      "if": {"properties": {"action": {"const": "error"}}},
      "then": {"required": ["error_code", "message"]}
    },
    {
      "if": {"properties": {"action": {"const": "done"}}},
      "then": {"required": ["verdict"]}
    },
    {
      "if": {"properties": {"action": {"const": "project_setup_required"}}},
      "then": {"required": ["reason_code", "missing_capabilities", "constraints"]}
    },
    {
      "if": {"properties": {"action": {"const": "session_rollover"}}},
      "then": {
        "required": [
          "reason", "current_session_id", "capsule", "claim_token", "expires_at"
        ],
        "properties": {
          "reason": {
            "enum": [
              "context_soft_limit", "context_hard_limit", "tick_limit",
              "time_limit", "manual"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
