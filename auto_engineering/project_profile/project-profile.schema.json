{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-engineering.dev/schemas/project-profile.schema.json",
  "title": "Auto-Engineering ProjectProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "paths", "commands", "evidence", "resolution"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "languages", "package_manager"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "package_manager": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_roots", "test_roots", "design_roots"],
      "properties": {
        "source_roots": {"$ref": "#/$defs/paths"},
        "test_roots": {"$ref": "#/$defs/paths"},
        "design_roots": {"$ref": "#/$defs/paths"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {"$ref": "#/$defs/command"},
        "lint": {"$ref": "#/$defs/command"},
        "type_check": {"$ref": "#/$defs/command"},
        "test": {"$ref": "#/$defs/command"},
        "build": {"$ref": "#/$defs/command"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "digest", "facts"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "facts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "confidence"],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "confidence": {"enum": ["confirmed", "partial"]}
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
