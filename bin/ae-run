#!/bin/sh
# 宿主 PATH 入口：只负责定位插件根，业务解析委托 scripts/ae-run。

set -u

BIN_DIR=$(CDPATH= cd -- "${0%/*}" && pwd -P)
PLUGIN_ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)

# The bundled entrypoint path is the one host fact that cannot be inherited
# from an outer CLI. Bind it before delegating to the shared runtime.
case "$PLUGIN_ROOT" in
    */.claude/plugins/*)
        AE_HOST_PLATFORM="claude-code"
        export AE_HOST_PLATFORM
        ;;
    */.codex/plugins/*)
        AE_HOST_PLATFORM="codex"
        export AE_HOST_PLATFORM
        ;;
esac

# A content-addressed staging root (used by release acceptance) has no
# `.claude/plugins` or `.codex/plugins` path marker. Prefer the host's native
# signal in that case so a Claude process launched from the Codex desktop does
# not inherit `CODEX_THREAD_ID` and bind the Action to the wrong adapter.
if [ -n "${CLAUDECODE:-}" ] || \
   [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || \
   [ -n "${CLAUDE_CODE:-}" ] || \
   [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ] || \
   [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
        AE_HOST_PLATFORM="claude-code"
        export AE_HOST_PLATFORM
elif [ -z "${AE_HOST_PLATFORM:-}" ] && \
     { [ -n "${CODEX_PLUGIN_ROOT:-}" ] || \
       [ -n "${CODEX_THREAD_ID:-}" ] || \
       [ -n "${CODEX_SANDBOX:-}" ]; }; then
        AE_HOST_PLATFORM="codex"
        export AE_HOST_PLATFORM
fi

exec "$PLUGIN_ROOT/scripts/ae-run" "$@"
