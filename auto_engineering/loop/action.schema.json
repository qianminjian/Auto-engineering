{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-engineering.dev/schemas/action.schema.json",
  "$comment": "action contract schema v1.1 — Core-to-host Protocol Envelope SSOT.",
  "title": "Tick Action Envelope",
  "type": "object",
  "required": [
    "schema_version", "message_type", "message_id", "thread_id", "tick",
    "stage", "correlation_id", "extensions", "action"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "message_type": {"const": "action"},
    "message_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "tick": {"type": "integer", "minimum": 0},
    "stage": {"type": ["string", "null"]},
    "causation_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "extensions": {
      "type": "object",
      "properties": {
        "ae": {
          "type": "object",
          "properties": {
            "execution_control": {"$ref": "#/$defs/executionControl"},
            "runtime_revision": {"$ref": "#/$defs/runtimeRevision"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "string",
      "enum": [
        "gap_scan", "gap_review", "research", "architect", "developer",
        "critic", "component_verifier", "plate_deep_audit",
        "system_verifier", "system_deep_audit", "gate", "skip",
        "project_setup_required", "resource_wait", "session_rollover", "done", "error"
      ]
    },
    "gate_summary": {"type": "object"},
    "feedback": {"type": ["string", "object", "null"]},
    "requirement": {"type": "string"},
    "feature_status": {"type": "object"},
    "progress_summary": {"type": ["string", "object", "null"]},
    "audit_execution_profile": {
      "type": "object",
      "required": ["profile", "audited_file_count", "dimension_count"],
      "properties": {
        "profile": {"enum": ["compact", "specialist"]},
        "audited_file_count": {"type": "integer", "minimum": 0},
        "dimension_count": {"const": 5}
      },
      "additionalProperties": false
    },
    "context": {"type": "object"},
    "expected_format": {"type": "object"},
    "gaps": {"type": "array"},
    "mode": {"type": "string"},
    "current_gap_index": {"type": "integer", "minimum": 0},
    "total_gaps": {"type": "integer", "minimum": 0},
    "current_gap": {"type": "object"},
    "auto_decision": {"type": ["object", "null"]},
    "decisions_so_far": {"type": "array"},
    "has_blocking": {"type": "boolean"},
    "is_rereview": {"type": "boolean"},
    "research_findings": {"type": "object"},
    "research_and_design_context": {"type": "array", "items": {"type": "object"}},
    "design_authority": {"type": "object"},
    "design_decision_ledger": {"type": "object"},
    "required_capabilities": {"type": "array"},
    "missing_capabilities": {"type": "array", "items": {"type": "string"}},
    "reason_code": {"type": "string"},
    "retry_attempt": {"type": "integer", "minimum": 1},
    "retry_limit": {"type": "integer", "minimum": 1},
    "constraints": {"type": "object"},
    "gap": {"type": "object"},
    "knowledge_sources": {"type": "object"},
    "valid_plate_keys": {"type": "array", "items": {"type": "string"}},
    "repair_contract": {"type": "object"},
    "resource": {"type": "string"},
    "retry_stage": {"type": "string"},
    "plate_keys": {"type": "array", "items": {"type": "string"}},
    "component": {"type": ["string", "null"]},
    "batch_id": {"type": ["string", "null"]},
    "tasks": {"type": "array"},
    "plan": {"type": "string"},
    "instruction": {"type": "string"},
    "subagent_prompt": {"type": "string"},
    "session_summary": {"type": "string"},
    "spawn": {"$ref": "#/$defs/spawnPlan"},
    "execution_identity": {"$ref": "#/$defs/executionIdentity"},
    "worker_execution_identity": {"$ref": "#/$defs/executionIdentity"},
    "spawn_proof_token": {"type": "string"},
    "recheck": {"type": "object"},
    "gate": {"type": "object"},
    "reason": {"type": ["string", "null"]},
    "next_transition": {"type": "string"},
    "error_code": {"type": "string"},
    "message": {"type": "string"},
    "suggestion": {"type": "string"},
    "current_state": {"type": "object"},
    "verdict": {"type": "string"},
    "verdict_level": {"type": ["integer", "null"]},
    "verdict_reason": {"type": ["string", "null"]},
    "rounds": {"type": "integer"},
    "checkpoint_id": {"type": "string"},
    "current_session_id": {"type": "string", "minLength": 1},
    "capsule": {
      "type": "object",
      "required": ["artifact_id", "sha256", "schema_version"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0"}
      },
      "additionalProperties": false
    },
    "claim_token": {"type": "string", "minLength": 1},
    "expires_at": {"type": ["string", "null"]}
    ,"metrics": {"type": "object"}
    ,"ratchet": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "resource_wait"}}},
      "then": {"required": ["resource", "retry_stage", "reason_code"]}
    },
    {
      "if": {"properties": {"action": {"const": "gate"}}},
      "then": {"required": ["gate"]}
    },
    {
      "if": {"properties": {"action": {"const": "skip"}}},
      "then": {"required": ["reason", "next_transition"]}
    },
    {
      "if": {"properties": {"action": {"const": "error"}}},
      "then": {"required": ["error_code", "message"]}
    },
    {
      "if": {"properties": {"action": {"const": "done"}}},
      "then": {"required": ["verdict"]}
    },
    {
      "if": {"properties": {"action": {"const": "project_setup_required"}}},
      "then": {"required": ["reason_code", "missing_capabilities", "constraints"]}
    },
    {
      "if": {"properties": {"action": {"const": "session_rollover"}}},
      "then": {
        "required": [
          "reason", "current_session_id", "capsule", "claim_token", "expires_at"
        ],
        "properties": {
          "reason": {
            "enum": [
              "host_process_lost", "context_compaction_failed", "cross_host",
              "manual_recovery"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "spawnPlan": {
      "type": "object",
      "required": ["count", "effort", "parallel"],
      "properties": {
        "contract_version": {"const": "1.0"},
        "count": {"type": "integer", "minimum": 1},
        "effort": {"type": "string", "minLength": 1},
        "parallel": {"type": "boolean"},
        "agents": {"type": "array", "items": {"type": "object"}},
        "invocations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/workerInvocation"}
        }
      },
      "allOf": [
        {
          "if": {"required": ["contract_version"]},
          "then": {"required": ["invocations"]}
        }
      ],
      "additionalProperties": false
    },
    "workerInvocation": {
      "type": "object",
      "required": [
        "worker_id", "role", "prompt_ref", "prompt_sha256",
        "requested_effort", "isolation", "capabilities", "receipt_path"
      ],
      "properties": {
        "worker_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "prompt_ref": {"type": "string", "minLength": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requested_effort": {"type": "string", "minLength": 1},
        "isolation": {"const": "fresh_context"},
        "capabilities": {
          "type": "object",
          "required": ["may_drive_loop", "may_spawn_workers"],
          "properties": {
            "may_drive_loop": {"const": false},
            "may_spawn_workers": {"const": false}
          },
          "additionalProperties": false
        },
        "receipt_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "executionIdentity": {
      "type": "object",
      "required": [
        "role", "stage", "may_drive_loop", "may_spawn_workers",
        "inherit_parent_context"
      ],
      "properties": {
        "role": {"enum": ["coordinator", "worker"]},
        "stage": {"type": "string", "minLength": 1},
        "may_drive_loop": {"type": "boolean"},
        "may_spawn_workers": {"type": "boolean"},
        "inherit_parent_context": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "executionControl": {
      "type": "object",
      "required": [
        "schema_version", "disposition", "continuation_required",
        "yield_allowed", "allowed_stop_reasons"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "disposition": {
          "enum": [
            "CONTINUE", "WAIT_RESOURCE", "WAIT_USER", "TERMINAL", "ERROR",
            "HANDOFF_REQUIRED"
          ]
        },
        "continuation_required": {"type": "boolean"},
        "yield_allowed": {"type": "boolean"},
        "allowed_stop_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runtimeRevision": {
      "type": "object",
      "required": [
        "protocol_version", "event_schema_version",
        "projection_schema_version", "action_contract_version",
        "prompt_revision", "policy_revision", "engine_build_id"
      ],
      "properties": {
        "protocol_version": {"type": "string", "minLength": 1},
        "event_schema_version": {"type": "string", "minLength": 1},
        "projection_schema_version": {"type": "string", "minLength": 1},
        "action_contract_version": {"type": "string", "minLength": 1},
        "prompt_revision": {"type": "string", "minLength": 1},
        "policy_revision": {"type": "string", "minLength": 1},
        "engine_build_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
