{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auto_engineering/metrics/metrics-event.schema.json",
  "title": "Metrics Event",
  "description": "Phase 20 metrics event schema (F.2.2). Each event is a structured dict written to events.jsonl.",
  "type": "object",
  "required": ["timestamp", "event_type", "thread_id", "payload"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 event timestamp"
    },
    "event_type": {
      "type": "string",
      "enum": ["requirement_start", "requirement_end", "tick_complete", "token_usage", "stage_transition", "convergence", "gate_result"],
      "description": "Event type discriminator"
    },
    "thread_id": {
      "type": "string",
      "description": "Cross-tick unique requirement identifier"
    },
    "ai_origin": {
      "type": "object",
      "description": "AI traceability marker (F.2.1). Top-level field for tick_complete/token_usage/stage_transition/gate_result events.",
      "properties": {
        "level": { "type": "string", "enum": ["none", "assisted", "led", "autonomous"] },
        "agent_role": { "type": "string" },
        "model_name": { "type": "string" },
        "model_version": { "type": "string" },
        "driver_type": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "description": "Event-type-specific payload (see per-type subschemas below)"
    }
  },
  "oneOf": [
    {
      "description": "requirement_start",
      "properties": {
        "event_type": { "const": "requirement_start" },
        "payload": {
          "type": "object",
          "required": ["requirement_hash"],
          "properties": {
            "requirement_hash": { "type": "string" }
          }
        }
      }
    },
    {
      "description": "requirement_end",
      "properties": {
        "event_type": { "const": "requirement_end" },
        "payload": {
          "type": "object",
          "required": ["verdict", "total_ticks"],
          "properties": {
            "verdict": { "type": "string" },
            "total_ticks": { "type": "integer" }
          }
        }
      }
    },
    {
      "description": "tick_complete",
      "required": ["ai_origin"],
      "properties": {
        "event_type": { "const": "tick_complete" },
        "payload": {
          "type": "object",
          "required": ["tick_number", "stage", "duration_ms"],
          "properties": {
            "tick_number": { "type": "integer" },
            "stage": { "type": "string" },
            "duration_ms": { "type": "integer" },
            "gate_results": { "type": "object" },
            "guardrail_results": { "type": "object" },
            "verdict": { "type": "string" }
          }
        }
      }
    },
    {
      "description": "token_usage",
      "required": ["ai_origin"],
      "properties": {
        "event_type": { "const": "token_usage" },
        "payload": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "total_tokens", "model", "provider", "stage"],
          "properties": {
            "input_tokens": { "type": "integer" },
            "output_tokens": { "type": "integer" },
            "total_tokens": { "type": "integer" },
            "model": { "type": "string" },
            "provider": { "type": "string" },
            "stage": { "type": "string" }
          }
        }
      }
    },
    {
      "description": "stage_transition",
      "required": ["ai_origin"],
      "properties": {
        "event_type": { "const": "stage_transition" },
        "payload": {
          "type": "object",
          "required": ["from_stage", "to_stage", "transition_reason"],
          "properties": {
            "from_stage": { "type": "string" },
            "to_stage": { "type": "string" },
            "transition_reason": { "type": "string" }
          }
        }
      }
    },
    {
      "description": "convergence",
      "properties": {
        "event_type": { "const": "convergence" },
        "payload": {
          "type": "object",
          "required": ["verdict", "total_ticks", "criteria_met"],
          "properties": {
            "verdict": { "type": "string" },
            "total_ticks": { "type": "integer" },
            "criteria_met": { "type": "string" }
          }
        }
      }
    },
    {
      "description": "gate_result",
      "properties": {
        "event_type": { "const": "gate_result" },
        "payload": {
          "type": "object",
          "required": ["gate_name", "passed", "duration_ms", "findings_count"],
          "properties": {
            "gate_name": { "type": "string" },
            "passed": { "type": "boolean" },
            "duration_ms": { "type": "integer" },
            "findings_count": { "type": "integer" }
          }
        }
      }
    }
  ]
}
